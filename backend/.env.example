# Backend Express Server Port
PORT=5000

# Node Execution Environment (development | test | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas in prod / Mongo container locally)
MONGO_URI=mongodb://localhost:27017/taskflow

# Secret key used for signing JWT tokens (Change in production!)
JWT_SECRET=supersecret_jwt_key_change_in_production

# JWT expiration time (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed CORS origin for frontend client
CORS_ORIGIN=http://localhost:3000
